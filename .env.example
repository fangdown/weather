# 和风天气：控制台中的 API Host（无末尾斜杠）
# 文档：https://dev.qweather.com/docs/configuration/api-host/
QWEATHER_API_HOST=https://xxxx.qweatherapi.com

# 凭据：API KEY 或 JWT 的「密钥串」都填在 QWEATHER_TOKEN
# 身份认证方式（默认 apikey = Header: X-QW-Api-Key）：apikey | jwt（Bearer）
# 说明：https://dev.qweather.com/docs/configuration/authentication/
QWEATHER_AUTH=apikey
QWEATHER_TOKEN=your_qweather_api_key

# DeepSeek OpenAI 兼容 API（可选；不配置则评语退化为天气状况原文）
# https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
